# Copy to .env and fill in. Never commit .env.
ESG_PROVIDER=fake                    # fake | openai | azure | gemini | anthropic

# Azure OpenAI / Microsoft Foundry (keyless with `az login` or managed identity)
ESG_AZURE_ENDPOINT=https://<resource>.openai.azure.com
ESG_AZURE_CHAT_DEPLOYMENT=gpt-5.4-mini
ESG_AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# ESG_AZURE_API_KEY=                 # optional; leave empty for keyless auth

# Gemini on Vertex AI (Application Default Credentials: `gcloud auth application-default login`)
ESG_GCP_PROJECT=<your-project-id>
ESG_GCP_LOCATION=global               # or eu, for EU data residency
ESG_GCP_EMBEDDING_LOCATION=europe-west1
ESG_GEMINI_MODEL=gemini-3.8-flash
# or, without Vertex AI: GOOGLE_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=
ESG_ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI API
# OPENAI_API_KEY=
ESG_OPENAI_MODEL=gpt-5.4-mini
